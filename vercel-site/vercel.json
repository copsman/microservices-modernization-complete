{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND-URL/api/:path*"
    },
    {
      "source": "/checkout",
      "destination": "https://YOUR-BACKEND-URL/checkout"
    },
    {
      "source": "/orders/:path*",
      "destination": "https://YOUR-BACKEND-URL/orders/:path*"
    }
  ]
}
