{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": " https://bunch-avon-aggregate-named.trycloudflare.com/api/:path*"
    },
    {
      "source": "/checkout",
      "destination": "https://bunch-avon-aggregate-named.trycloudflare.com/checkout"
    },
    {
      "source": "/orders/:path*",
      "destination": "https://bunch-avon-aggregate-named.trycloudflare.com/orders/:path*"
    }
  ]
}