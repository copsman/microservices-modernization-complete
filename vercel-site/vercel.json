{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://127.0.0.1:8000/api/:path*"
    },
    {
      "source": "/checkout",
      "destination": "https://127.0.0.1:8000/checkout"
    },
    {
      "source": "/orders/:path*",
      "destination": "https://127.0.0.1:8000/orders/:path*"
    }
  ]
}